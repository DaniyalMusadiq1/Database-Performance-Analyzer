{
  "name": "database-performance-analyzer",
  "displayName": "Database Performance Analyzer",
  "description": "Understand database performance across PostgreSQL, MySQL, SQL Server, SQLite, MongoDB and Redis directly in VS Code.",
  "version": "1.3.0",
  "publisher": "DaniyalMusadiq",
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "database",
    "performance",
    "postgresql",
    "mysql",
    "mongodb",
    "redis",
    "sqlite",
    "sqlserver"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The dashboard and demo are available. Database access and project inspection require a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onView:dbPerf.connections"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dbPerf.open",
        "title": "Database Performance: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "dbPerf.add",
        "title": "Database Performance: Add Connection",
        "icon": "$(add)"
      },
      {
        "command": "dbPerf.detect",
        "title": "Database Performance: Detect Databases and Models",
        "icon": "$(search)"
      },
      {
        "command": "dbPerf.demo",
        "title": "Database Performance: Explore Demo"
      },
      {
        "command": "dbPerf.refresh",
        "title": "Database Performance: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "dbPerf.explain",
        "title": "Database Performance: Explain Selected SQL",
        "icon": "$(pulse)"
      },
      {
        "command": "dbPerf.remove",
        "title": "Database Performance: Remove Connection",
        "icon": "$(trash)"
      },
      {
        "command": "dbPerf.password",
        "title": "Database Performance: Update Connection URL",
        "icon": "$(key)"
      },
      {
        "command": "dbPerf.manage",
        "title": "Database Performance: Manage Connection",
        "icon": "$(settings-gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbPerf",
          "title": "Database Performance",
          "icon": "media/database.svg"
        }
      ]
    },
    "views": {
      "dbPerf": [
        {
          "id": "dbPerf.connections",
          "name": "Connections"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dbPerf.connections",
        "contents": "Understand your database, from query to cluster.\n[Add Connection](command:dbPerf.add)\n[Detect Project Databases](command:dbPerf.detect)\n[Explore Demo](command:dbPerf.demo)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbPerf.add",
          "when": "view == dbPerf.connections",
          "group": "navigation"
        },
        {
          "command": "dbPerf.detect",
          "when": "view == dbPerf.connections",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dbPerf.remove",
          "when": "view == dbPerf.connections && viewItem == database",
          "group": "inline"
        },
        {
          "command": "dbPerf.password",
          "when": "view == dbPerf.connections && viewItem == database"
        },
        {
          "command": "dbPerf.manage",
          "when": "view == dbPerf.connections && viewItem == database"
        }
      ],
      "editor/context": [
        {
          "command": "dbPerf.explain",
          "when": "editorLangId == sql",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Database Performance Analyzer",
      "properties": {
        "dbPerf.queryTimeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 60000,
          "description": "Maximum time per database operation, in milliseconds."
        },
        "dbPerf.refreshIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 300,
          "description": "Refresh interval when live monitoring is explicitly enabled."
        },
        "dbPerf.slowQueryMs": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Mean query latency threshold for advisory findings."
        },
        "dbPerf.maxHistory": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 300,
          "description": "Number of snapshots retained in memory per connection."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/licenses.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx scripts/test.mjs",
    "test:integration": "node --import tsx scripts/test.mjs --integration",
    "test:host": "node scripts/host-test.mjs",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "publish:marketplace": "node scripts/publish.mjs",
    "verify": "npm run check && npm test && npm run build",
    "test:ui": "node scripts/ui-test.mjs",
    "format": "prettier --write src media/*.js media/*.css test scripts/*.mjs package.json tsconfig.json .vscode/*.json .github/workflows/*.yml",
    "format:check": "prettier --check src media/*.js media/*.css test scripts/*.mjs package.json tsconfig.json .vscode/*.json .github/workflows/*.yml"
  },
  "dependencies": {
    "mongodb": "^7.7.0",
    "mssql": "^12.7.4",
    "mysql2": "^3.24.5",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DaniyalMusadiq1/Database-Performance-Analyzer.git"
  },
  "homepage": "https://github.com/DaniyalMusadiq1/Database-Performance-Analyzer#readme",
  "bugs": {
    "url": "https://github.com/DaniyalMusadiq1/Database-Performance-Analyzer/issues"
  }
}
